# Terraform state files — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with real values — use *.example files instead
terraform.tfvars
*.auto.tfvars

# Terraform working directories
**/.terraform/
**/.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Terraform plan output files
*.tfplan

# Sensitive outputs
output.json

# IDE
.idea/
*.iml
.vscode/

# macOS
.DS_Store
