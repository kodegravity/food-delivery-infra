# Copy this file to terraform.tfvars and adjust values as needed.
# Never commit terraform.tfvars to source control — it may contain sensitive data.

aws_region  = "ca-central-1"
project     = "food-delivery"
environment = "dev"

# VPC
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]
availability_zones   = ["ca-central-1a", "ca-central-1b"]

# ECR / services
service_names = ["api-gateway", "user-service", "restaurant-service", "order-service"]

# RDS
db_name              = "fooddelivery"
db_username          = "fooddelivery"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
postgres_version     = "16.3"

# ECS Fargate
task_cpu       = 256
task_memory    = 512
desired_count  = 1
container_port = 8080

# CloudWatch
log_retention_days = 7
